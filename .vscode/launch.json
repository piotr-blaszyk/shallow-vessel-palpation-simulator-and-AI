{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "psb120 debug python module (/scripts/)",
            "type": "debugpy",
            "request": "launch",
            "module": "difftactile.scripts.${fileBasenameNoExtension}",
            "console": "integratedTerminal",
            "cwd": "/home/psb120/Documents/DiffTactile",
        },
    
        {
            "name": "psb120 debug current file (/sensor_model/)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/difftactile/sensor_model",
        },
        {
            "name": "psb120 debug current file (/tasks/)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/difftactile/tasks",
        },
        {
            "name": "psb120 debug current file (/ml_training/)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/difftactile/ml_training",
        },
        {
            "name": "psb120 debug object_repose",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/difftactile/tasks/object_repose.py",
            "console": "integratedTerminal",
            "args": "--use_tactile --use_state",
            "cwd": "${workspaceFolder}/difftactile/tasks",
        },
        {
            "name": "psb120 debug current file (root)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "/home/psb120/Documents/DiffTactile"
        }
    ]
}